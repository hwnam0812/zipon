{
  "name": "baze-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "db:init": "node scripts/db-init.mjs",
    "test": "node --experimental-strip-types --test test/home-model.test.ts test/home-worker.test.mjs test/home-automation.test.mjs",
    "test:usb": "python3 -B -m unittest discover -s test -p 'test_usb_*.py'",
    "test:firmware": "node scripts/test-firmware.mjs",
    "test:firmware:v4": "node scripts/test-firmware-v4.mjs",
    "test:streamlit": "node --test test/streamlit-model.test.mjs",
    "test:streamlit:browser": "node test/streamlit-browser.mjs",
    "package:streamlit": "node scripts/package-streamlit.mjs",
    "check": "node ../_tools/check.mjs ."
  },
  "dependencies": {
    "hono": "^4.10.2",
    "lucide-react": "^0.545.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.149.0"
  }
}
